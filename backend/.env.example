# Copy to .env and adjust. NEVER commit .env.
DATABASE_URL=postgresql+psycopg://researchforge:researchforge@localhost:5432/researchforge
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# REQUIRED (>= 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ENVIRONMENT=development
# Production over HTTPS: set COOKIE_SECURE=true (the app refuses to start in production without it)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set to true to require a verified email before login
REQUIRE_EMAIL_VERIFICATION=false

# Email: leave SMTP_HOST empty in development -> links are printed in the API console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ResearchForge <no-reply@researchforge.local>

# Only behind a reverse proxy you control (so rate limits see the real client IP)
TRUST_PROXY_HEADERS=false
