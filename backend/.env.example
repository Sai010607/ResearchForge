# Copy to .env and adjust. NEVER commit .env.
DATABASE_URL=postgresql+psycopg://researchforge:researchforge@localhost:5432/researchforge
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# REQUIRED (>= 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ENVIRONMENT=development
# Production over HTTPS: set COOKIE_SECURE=true (the app refuses to start in production without it)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set to true to require a verified email before login
REQUIRE_EMAIL_VERIFICATION=false

# Email priority: BREVO_API_KEY (HTTPS, works on Render free) > SMTP_HOST > console (links printed in the API log).
# For Gmail over SMTP locally: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (or 465 with SMTP_SSL=true), SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<Google App Password>, MAIL_FROM=ResearchForge <you@gmail.com>. Render free instances block SMTP ports.
BREVO_API_KEY=
# Email: leave SMTP_HOST empty in development -> links are printed in the API console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ResearchForge <no-reply@researchforge.local>

# Only behind a reverse proxy you control (so rate limits see the real client IP)
TRUST_PROXY_HEADERS=false

# --- literature providers (all optional; every provider works without a key) ---
# OpenAlex / Crossref / NCBI move you to their faster "polite" pools when they can contact you.
CONTACT_EMAIL=
# Semantic Scholar is rate-limited without a key and is therefore OFF by default until a key is set.
SEMANTIC_SCHOLAR_API_KEY=
# NCBI/PubMed: 3 requests/s without a key, 10/s with one.
NCBI_API_KEY=
# Springer Nature (free key, https://dev.springernature.com). The provider stays OFF until one of these is set.
# Meta API key preferred; if you only have an Open Access API key, set SPRINGER_OA_API_KEY instead.
SPRINGER_API_KEY=
SPRINGER_OA_API_KEY=
